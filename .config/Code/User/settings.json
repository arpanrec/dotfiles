{
    "[ansible]": {
        "editor.autoIndent": "advanced",
        "editor.detectIndentation": false,
        "editor.quickSuggestions": {
            "comments": true,
            "other": true,
            "strings": true
        },
        "prettier.singleQuote": false
    },
    "[dockerbake]": {
        "editor.defaultFormatter": "docker.docker"
    },
    "[dockerfile]": {
        "editor.defaultFormatter": "ms-azuretools.vscode-containers"
    },
    "[github-actions-workflow]": {
        "prettier.singleQuote": false
    },
    "[go.mod]": {
        "editor.defaultFormatter": "golang.go"
    },
    "[go]": {
        "editor.defaultFormatter": "golang.go"
    },
    "[ignore]": {
        "editor.defaultFormatter": "foxundermoon.shell-format"
    },
    "[java]": {
        "breadcrumbs.showArrays": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports.ruff": "always"
        },
        "editor.defaultFormatter": "redhat.java",
        "editor.maxTokenizationLineLength": 20000,
        "editor.suggest.snippetsPreventQuickSuggestions": false,
        "outline.showVariables": true
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "files.insertFinalNewline": false,
        "files.trimFinalNewlines": true
    },
    "[jsonc]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[lua]": {
        "editor.defaultFormatter": "sumneko.lua"
    },
    "[markdown]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[python]": {
        "editor.codeActionsOnSave": {
            "source.organizeImports.ruff": "always"
        },
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.wordBasedSuggestions": "off"
    },
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer"
    },
    "[terraform]": {
        "editor.defaultFormatter": "hashicorp.terraform"
    },
    "[toml]": {
        "editor.defaultFormatter": "tamasfe.even-better-toml"
    },
    "[xml]": {
        "editor.defaultFormatter": "redhat.vscode-xml"
    },
    "[yaml]": {
        "prettier.singleQuote": false
    },
    "ansible.ansible.path": "ansible",
    "ansible.ansible.useFullyQualifiedCollectionNames": true,
    "ansible.lightspeed.enabled": false,
    "ansible.lightspeed.suggestions.enabled": false,
    "ansible.validation.enabled": true,
    "ansible.validation.lint.enabled": true,
    "ansible.validation.lint.path": "ansible-lint",
    "ansibleServer.trace.server": "messages",
    "black-formatter.args": ["--line-length", "120"],
    "claudeCode.hideOnboarding": true,
    "claudeCode.preferredLocation": "panel",
    "diffEditor.ignoreTrimWhitespace": false,
    "docker.extension.enableComposeLanguageServer": false,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.detectIndentation": false,
    "editor.fontFamily": "'JetBrainsMono Nerd Font', monospace",
    "editor.fontLigatures": true,
    "editor.formatOnSave": false,
    "editor.indentSize": "tabSize",
    "editor.inlineSuggest.enabled": true,
    "editor.insertSpaces": true,
    "editor.minimap.enabled": false,
    "editor.mouseWheelZoom": true,
    "editor.suggestSelection": "first",
    "editor.tabSize": 4,
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 120,
    "excalidraw.image": {
        "exportScale": 1,
        "exportWithBackground": true,
        "exportWithDarkMode": false
    },
    "excalidraw.language": "en",
    "excalidraw.theme": "dark",
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.fileNesting.patterns": {
        "*.db": "${capture}.${extname}-*",
        "*.db3": "${capture}.${extname}-*",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.s3db": "${capture}.${extname}-*",
        "*.sdb": "${capture}.${extname}-*",
        "*.sqlite": "${capture}.${extname}-*",
        "*.sqlite3": "${capture}.${extname}-*",
        "*.ts": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
        "tsconfig.json": "tsconfig.*.json"
    },
    "extensions.autoUpdate": "off",
    "files.associations": {
        ".git/config": "gitconfig",
        "*.css": "tailwindcss",
        "**/.ansible-lint": "yaml",
        "**/.yamlfmt": "yaml",
        "**/.yamllint": "yaml",
        "**/*.tf": "terraform",
        "**/ansible.cfg": "ini",
        "**/ansible/**/*.yaml": "ansible",
        "**/ansible/**/*.yml": "ansible",
        "**/requirements-dev.in": "pip-requirements",
        "**/requirements-dev.txt": "pip-requirements",
        "**/requirements.txt": "pip-requirements",
        "**/tasks/**/*.yaml": "ansible",
        "**/tasks/**/*.yml": "ansible",
        "site*.yaml": "ansible",
        "site*.yml": "ansible"
    },
    "files.exclude": {
        "**/__pycache__/**": true,
        "**/.classpath": true,
        "**/.factorypath": true,
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/.mypy_cache/**": true,
        "**/.project": true,
        "**/.pytest_cache/**": true,
        "**/.ruff_cache/**": true,
        "**/.settings": true,
        "**/.trunk/**": true,
        "**/.venv/**": true,
        "**/.cache/**": true,
        "**/node_modules/**": true
    },
    "files.trimTrailingWhitespace": false,
    "files.watcherExclude": {
        "**/__pycache__/**": true,
        "**/.classpath": true,
        "**/.factorypath": true,
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/.mypy_cache/**": true,
        "**/.project": true,
        "**/.pytest_cache/**": true,
        "**/.ruff_cache/**": true,
        "**/.settings": true,
        "**/.trunk/**": true,
        "**/.venv/**": true,
        "**/.cache/**": true,
        "**/node_modules/**": true
    },
    "git.autofetch": false,
    "git.confirmSync": false,
    "git.enableSmartCommit": true,
    "git.ignoreLegacyWarning": true,
    "git.openDiffOnClick": true,
    "git.openRepositoryInParentFolders": "always",
    "github.copilot.enable": {
        "*": false,
        "ansible": false,
        "markdown": false,
        "plaintext": false,
        "scminput": false,
        "shellscript": false,
        "yaml": false
    },
    "githubPullRequests.createOnPublishBranch": "never",
    "githubPullRequests.pullBranch": "never",
    "html.format.wrapLineLength": 120,
    "java.autobuild.enabled": true,
    "java.checkstyle.autocheck": true,
    "java.completion.enabled": true,
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.format.settings.profile": "GoogleStyle",
    "java.format.settings.url": "https://raw.githubusercontent.com/google/styleguide/gh-pages/eclipse-java-google-style.xml",
    "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx1G -Xms100m",
    "java.project.importOnFirstTimeStartup": "automatic",
    "liveServer.settings.donotShowInfoMsg": true,
    "liveServer.settings.donotVerifyTags": true,
    "maven.dependency.enableConflictDiagnostics": true,
    "prettier.printWidth": 120,
    "prettier.requireConfig": false,
    "prettier.singleQuote": true,
    "prettier.tabWidth": 4,
    "prettier.useEditorConfig": true,
    "prettier.useTabs": false,
    "python.analysis.typeCheckingMode": "strict",
    "python.terminal.useEnvFile": false,
    "redhat.telemetry.enabled": false,
    "remote.autoForwardPorts": false,
    "security.workspace.trust.untrustedFiles": "open",
    "telemetry.telemetryLevel": "off",
    "terminal.integrated.env.linux": {
        "DEBUG": "true"
    },
    "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', monospace",
    "terminal.integrated.persistentSessionScrollback": 1000,
    "terraform.mcp.server.enable": false,
    "update.showReleaseNotes": false,
    "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",
    "window.zoomLevel": 1,
    "workbench.colorTheme": "GitHub Dark Default",
    "workbench.editor.enablePreview": false,
    "workbench.editorAssociations": {
        "*.excalidraw": "editor.excalidraw",
        "*.ipynb": "default"
    },
    "workbench.iconTheme": "material-icon-theme",
    "workbench.startupEditor": "none",
    "yaml.customTags": ["!vault"],
    "yaml.format.enable": false,
    "yaml.format.printWidth": 120,
    "yaml.schemas": {
        "https://json.schemastore.org/github-workflow.json": [
            "**/.github/workflows/*.yml",
            "**/.github/workflows/*.yaml",
            "**/.gitea/workflows/*.yml",
            "**/.gitea/workflows/*.yaml",
            "**/.forgejo/workflows/*.yml",
            "**/.forgejo/workflows/*.yaml"
        ]
    }
}
