# shellcheck disable=SC2148

export LANG="en_US.UTF-8"
export LC_CTYPE="en_US.UTF-8"
export LC_NUMERIC="en_US.UTF-8"
export LC_TIME="en_US.UTF-8"
export LC_COLLATE="en_US.UTF-8"
export LC_MONETARY="en_US.UTF-8"
export LC_MESSAGES="en_US.UTF-8"
export LC_PAPER="en_US.UTF-8"
export LC_NAME="en_US.UTF-8"
export LC_ADDRESS="en_US.UTF-8"
export LC_TELEPHONE="en_US.UTF-8"
export LC_MEASUREMENT="en_US.UTF-8"
export LC_IDENTIFICATION="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"
export CLOUD_INIT_IS_DEV_MACHINE=true

# Prepend a directory to PATH unless it is already present.
__dotfiles_path_prepend() {
    case ":${PATH}:" in
    *":$1:"*) ;;
    *) export PATH="$1${PATH:+:${PATH}}" ;;
    esac
}

for __dotfiles_lib in "${HOME}/.local/lib" "${HOME}/.local/lib64"; do
    case ":${LD_LIBRARY_PATH:-}:" in
    *":${__dotfiles_lib}:"*) ;;
    *) export LD_LIBRARY_PATH="${__dotfiles_lib}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" ;;
    esac
done
unset __dotfiles_lib

__dotfiles_path_prepend "/usr/local/bin"

if [ -f "${HOME}/.env" ]; then
    # shellcheck source=/dev/null
    source "${HOME}/.env"
fi

__dotfiles_path_prepend "/usr/local/sbin"
__dotfiles_path_prepend "/sbin"
__dotfiles_path_prepend "/usr/sbin"

if [[ -d "/var/lib/snapd/snap/bin" ]]; then
    __dotfiles_path_prepend "/var/lib/snapd/snap/bin"
fi

if [[ -d "${HOME}/.local/share/JetBrains/Toolbox/scripts" ]]; then
    __dotfiles_path_prepend "${HOME}/.local/share/JetBrains/Toolbox/scripts"
fi

if [ -f "${HOME}/.local/share/go/bin/go" ]; then
    __dotfiles_path_prepend "${HOME}/.local/share/go/bin"
fi

export GOPATH="${HOME}/.go"
__dotfiles_path_prepend "${GOPATH}/bin"

if [ -f "${HOME}/.local/share/node/bin/node" ]; then
    __dotfiles_path_prepend "${HOME}/.local/share/node/bin"
fi

if [ -f "${HOME}/.pre.jdk.env.sh" ]; then
    # shellcheck source=/dev/null
    source "${HOME}/.pre.jdk.env.sh"
fi

if [ -f "${HOME}/.jdk.env.sh" ]; then
    # shellcheck source=/dev/null
    source "${HOME}/.jdk.env.sh"
fi

if [[ -f "${HOME}/.local/share/coursier/bin/cs" ]]; then
    __dotfiles_path_prepend "${HOME}/.local/share/coursier/bin"
fi

__dotfiles_path_prepend "${HOME}/.local/bin"
__dotfiles_path_prepend "${HOME}/bin"

if [[ -f "${HOME}/.cargo/bin/cargo" ]]; then
    __dotfiles_path_prepend "${HOME}/.cargo/bin"
fi

if [[ -f "${HOME}/.pulumi/bin/pulumi" ]]; then
    __dotfiles_path_prepend "${HOME}/.pulumi/bin"
fi

# zsh exposes the terminal as $TTY, which stays correct under the p10k instant prompt
# where stdin is redirected and `tty` reports "not a tty".
if [ -n "${ZSH_VERSION:-}" ] && [ -n "${TTY:-}" ]; then
    export GPG_TTY="${TTY}"
elif [ -t 0 ]; then
    GPG_TTY="$(tty 2>/dev/null)"
    if [ -n "$GPG_TTY" ] && [ "$GPG_TTY" != "not a tty" ]; then
        export GPG_TTY
    else
        unset GPG_TTY
    fi
else
    unset GPG_TTY
fi

# Not working on centos7 systems
# gpg-connect-agent updatestartuptty /bye >/dev/null

if command -v vim &>/dev/null; then
    export EDITOR=vim
fi

if [[ -f "/usr/bin/ksshaskpass" ]]; then
    export SSH_ASKPASS="/usr/bin/ksshaskpass"
    export SSH_ASKPASS_REQUIRE=prefer
    export GIT_ASKPASS="/usr/bin/ksshaskpass"
fi

# Miniconda
if [[ -d "${HOME}/.miniconda3" ]]; then
    __dotfiles_path_prepend "${HOME}/.miniconda3/bin"
fi
if [[ -d "${HOME}/miniconda3" ]]; then
    __dotfiles_path_prepend "${HOME}/miniconda3/bin"
fi
if [[ -d "${HOME}/.dotnet/tools" ]]; then
    __dotfiles_path_prepend "${HOME}/.dotnet/tools"
fi

export PNPM_HOME="${HOME}/.local/share/pnpm"
__dotfiles_path_prepend "${PNPM_HOME}"

export BUN_INSTALL="${HOME}/.bun"
__dotfiles_path_prepend "${BUN_INSTALL}/bin"

brave_profile() {
    local profile="${1:-}"
    local bravecmd

    if [[ -z "$profile" || "${#profile}" -le 1 ]]; then
        printf 'brave-profile: profile name must be longer than 1 character\n' >&2
        return 2
    fi

    bravecmd=$(command -v brave || command -v brave-browser) || {
        printf 'brave-profile: brave browser not found\n' >&2
        return 127
    }

    "$bravecmd" \
        --user-data-dir="$HOME/.local/share/brave-user-data-dir/$profile" \
        >/dev/null 2>&1 &
    disown
}

chrome_profile() {
    local profile="${1:-}"
    local chromecmd

    # validate profile name
    if [[ -z "$profile" || "${#profile}" -le 1 ]]; then
        printf 'google-chrome-profile: profile name must be longer than 1 character\n' >&2
        return 2
    fi

    chromecmd=$(command -v google-chrome || command -v google-chrome-stable) || {
        printf 'google-chrome-profile: chrome browser not found\n' >&2
        return 127
    }

    "$chromecmd" \
        --user-data-dir="$HOME/.local/share/google-chrome-user-data-dir/$profile" \
        >/dev/null 2>&1 &
    disown
}

unset -f __dotfiles_path_prepend
