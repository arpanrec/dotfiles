#!/usr/bin/env bash
set -euo pipefail

CURRENT_ARCH="$(uname -m)"

case "${CURRENT_ARCH}" in
x86_64)
    DOWNLOAD_ARCH_KEY="x64"
    ;;
aarch64 | arm64)
    DOWNLOAD_ARCH_KEY="arm64"
    ;;
*)
    echo "Unsupported architecture: ${CURRENT_ARCH}"
    exit 1
    ;;
esac

if compgen -G "/lib/ld-musl-*" >/dev/null; then
    DOWNLOAD_ARCH_KEY="${DOWNLOAD_ARCH_KEY}-musl"
fi

CLAUDE_CODE_LATEST_VERSION="$(curl -sSfL --connect-timeout 10 --max-time 60 \
    "https://api.github.com/repos/anthropics/claude-code/releases/latest" |
    jq -r ".tag_name")"

if [[ -z "${CLAUDE_CODE_LATEST_VERSION}" || "${CLAUDE_CODE_LATEST_VERSION}" == "null" ]]; then
    echo "Failed to get latest version."
    exit 1
fi

echo "Installing Claude Code version ${CLAUDE_CODE_LATEST_VERSION}"

TMP_DOWNLOAD_DIRECTORY="${HOME}/.cache/dotfiles-tmp-download-dir"
INSTALL_DIRECTORY="${HOME}/.local/share/claude-code"
ARCHIVE_NAME="claude-linux-${DOWNLOAD_ARCH_KEY}.tar.gz"
ARCHIVE_PATH="${TMP_DOWNLOAD_DIRECTORY}/claude-code-${CLAUDE_CODE_LATEST_VERSION}-${ARCHIVE_NAME}"
RELEASE_URL="https://github.com/anthropics/claude-code/releases/download/${CLAUDE_CODE_LATEST_VERSION}"

mkdir -p "${TMP_DOWNLOAD_DIRECTORY}" "${INSTALL_DIRECTORY}" "${HOME}/.local/bin"

echo "Downloading Claude Code ${CLAUDE_CODE_LATEST_VERSION} for ${CURRENT_ARCH} architecture"

if [[ ! -f "${ARCHIVE_PATH}" ]]; then
    curl -fL --connect-timeout 10 --max-time 600 \
        "${RELEASE_URL}/${ARCHIVE_NAME}" \
        -o "${ARCHIVE_PATH}"
else
    echo "Archive already exists"
fi

echo "Verifying checksum"
EXPECTED_CHECKSUM="$(curl -sSfL --connect-timeout 10 --max-time 60 \
    "${RELEASE_URL}/SHASUMS256.txt" |
    awk -v name="${ARCHIVE_NAME}" '$2 == name { print $1 }')"

if [[ -z "${EXPECTED_CHECKSUM}" ]]; then
    echo "Failed to get checksum for ${ARCHIVE_NAME}"
    exit 1
fi

if ! echo "${EXPECTED_CHECKSUM}  ${ARCHIVE_PATH}" | sha256sum -c -; then
    echo "Checksum mismatch, removing ${ARCHIVE_PATH}"
    rm -f "${ARCHIVE_PATH}"
    exit 1
fi

rm -rf "${INSTALL_DIRECTORY}"
mkdir -p "${INSTALL_DIRECTORY}"

tar -xzf "${ARCHIVE_PATH}" -C "${INSTALL_DIRECTORY}"

if [[ ! -f "${INSTALL_DIRECTORY}/claude" ]]; then
    echo "Extraction failed: claude binary not found"
    exit 1
fi

chmod +x "${INSTALL_DIRECTORY}/claude"

rm -f "${HOME}/.local/bin/claude"
ln -s "${INSTALL_DIRECTORY}/claude" "${HOME}/.local/bin/claude"

echo "Claude Code installed successfully!"
"${HOME}/.local/bin/claude" --version
