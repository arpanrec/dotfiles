#!/usr/bin/env bash
set -euo pipefail

CURRENT_ARCH="$(uname -m)"

case "${CURRENT_ARCH}" in
x86_64)
    DOWNLOAD_ARCH_KEY=""
    ;;
*)
    echo "Unsupported architecture: ${CURRENT_ARCH}"
    exit 1
    ;;
esac

TMP_DOWNLOAD_DIRECTORY="${HOME}/.cache/dotfiles-tmp-download-dir"
POSTMAN_LATEST_VERSION="${POSTMAN_LATEST_VERSION:-12.11.3}"
POSTMAN_ZIP_FILE_NAME="Postman-${POSTMAN_LATEST_VERSION}${DOWNLOAD_ARCH_KEY}.tar.gz"
INSTALL_DIRECTORY="${HOME}/.local/share/Postman"
APPLICATION_DIRECTORY="${HOME}/.local/share/applications"
DOWNLOAD_URI="https://dl.pstmn.io/download/version/${POSTMAN_LATEST_VERSION}/linux"

rm -rf "${INSTALL_DIRECTORY}"
mkdir -p "${INSTALL_DIRECTORY}" "${APPLICATION_DIRECTORY}" "${TMP_DOWNLOAD_DIRECTORY}"

if [[ ! -f "${TMP_DOWNLOAD_DIRECTORY}/${POSTMAN_ZIP_FILE_NAME}" ]]; then
    echo "Downloading Postman."
    curl -fL --connect-timeout 10 --max-time 600 "${DOWNLOAD_URI}" -o "${TMP_DOWNLOAD_DIRECTORY}/${POSTMAN_ZIP_FILE_NAME}"
else
    echo "Postman already exists"
fi
tar -zxvf "${TMP_DOWNLOAD_DIRECTORY}/${POSTMAN_ZIP_FILE_NAME}" -C "${INSTALL_DIRECTORY}" --strip-components=1

tee "${APPLICATION_DIRECTORY}/postman.desktop" <<EOF
[Desktop Entry]
Encoding=UTF-8
Name=Postman
Exec=${INSTALL_DIRECTORY}/Postman %u
Icon=${INSTALL_DIRECTORY}/app/resources/app/assets/icon.png
Terminal=false
Type=Application
Categories=Development;
EOF
