#!/usr/bin/env bash
set -euo pipefail

if [[ "$(uname -m)" != "x86_64" ]]; then
    echo "Only x86_64 architecture is supported."
    exit 1
fi

if [[ -z "${TELEGRAM_DESKTOP_LATEST_VERSION:-}" ]]; then
    TELEGRAM_DESKTOP_LATEST_VERSION="$(curl -sSfL --connect-timeout 10 --max-time 60 \
        "https://api.github.com/repos/telegramdesktop/tdesktop/releases/latest" |
        jq -r ".tag_name")"
fi

if [[ -z "${TELEGRAM_DESKTOP_LATEST_VERSION}" || "${TELEGRAM_DESKTOP_LATEST_VERSION}" == "null" ]]; then
    echo "Failed to get latest version."
    exit 1
fi
echo "Installing Telegram Desktop version ${TELEGRAM_DESKTOP_LATEST_VERSION}"

INSTALL_DIRECTORY="${HOME}/.local/share/Telegram"
APPLICATION_DIRECTORY="${HOME}/.local/share/applications"

rm -rf "${INSTALL_DIRECTORY}"

TMP_DOWNLOAD_DIRECTORY="${HOME}/.cache/dotfiles-tmp-download-dir"

mkdir -p "${TMP_DOWNLOAD_DIRECTORY}" "${APPLICATION_DIRECTORY}" "${INSTALL_DIRECTORY}"
echo "Downloading Telegram Desktop version ${TELEGRAM_DESKTOP_LATEST_VERSION} for $(uname -m) architecture to ${TMP_DOWNLOAD_DIRECTORY}"

if [[ ! -f "${TMP_DOWNLOAD_DIRECTORY}/td-setup-linux-x64-${TELEGRAM_DESKTOP_LATEST_VERSION:1}.tar.xz" ]]; then
    curl -fL --connect-timeout 10 --max-time 600 "https://github.com/telegramdesktop/tdesktop/releases/download/${TELEGRAM_DESKTOP_LATEST_VERSION}/td-setup-linux-x64-${TELEGRAM_DESKTOP_LATEST_VERSION:1}.tar.xz" \
        -o "${TMP_DOWNLOAD_DIRECTORY}/td-setup-linux-x64-${TELEGRAM_DESKTOP_LATEST_VERSION:1}.tar.xz"
else
    echo "Tarball File already exists"
fi

EXPECTED_CHECKSUM="$(curl -sSfL --connect-timeout 10 --max-time 60 \
    "https://api.github.com/repos/telegramdesktop/tdesktop/releases/tags/${TELEGRAM_DESKTOP_LATEST_VERSION}" |
    jq -r --arg name "td-setup-linux-x64-${TELEGRAM_DESKTOP_LATEST_VERSION:1}.tar.xz" \
        '.assets[] | select(.name == $name) | .digest' |
    sed 's/^sha256://')"

if [[ -z "${EXPECTED_CHECKSUM}" || "${EXPECTED_CHECKSUM}" == "null" ]]; then
    echo "Failed to get checksum from GitHub release."
    exit 1
fi

echo "Verifying checksum."

if ! echo "${EXPECTED_CHECKSUM}  ${TMP_DOWNLOAD_DIRECTORY}/td-setup-linux-x64-${TELEGRAM_DESKTOP_LATEST_VERSION:1}.tar.xz" |
    sha256sum -c -; then
    echo "Checksum mismatch, removing ${TMP_DOWNLOAD_DIRECTORY}/td-setup-linux-x64-${TELEGRAM_DESKTOP_LATEST_VERSION:1}.tar.xz"
    rm -f "${TMP_DOWNLOAD_DIRECTORY}/td-setup-linux-x64-${TELEGRAM_DESKTOP_LATEST_VERSION:1}.tar.xz"
    exit 1
fi

tar -xf "${TMP_DOWNLOAD_DIRECTORY}/td-setup-linux-x64-${TELEGRAM_DESKTOP_LATEST_VERSION:1}.tar.xz" \
    -C "${INSTALL_DIRECTORY}" --strip-components=1

find "${APPLICATION_DIRECTORY}" -type f -name "*telegram*" -exec rm -f {} \;

