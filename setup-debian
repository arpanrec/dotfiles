#!/usr/bin/env bash
# Bootstraps a Debian machine as root with the arpanrec.nebula.cloudinit Ansible playbook, then optionally installs
# dotfiles and runs setup-workspace as the created user. Configured entirely through environment variables.
set -euo pipefail

log() {
    printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >&2
}

die() {
    log "ERROR: $*"
    exit 1
}

# en_US.UTF-8 is only generated further down, C.UTF-8 is always present on Debian.
export LANG="C.UTF-8"
export LC_ALL="C.UTF-8"
export DEBIAN_FRONTEND="noninteractive"

if [[ "$(id -u)" -ne 0 ]]; then
    die "Run this script as root"
fi

if [[ "${HOME}" != "/root" ]]; then
    die "HOME is ${HOME}, it must be /root"
fi

command -v apt-get >/dev/null 2>&1 || die "apt-get not found, only Debian based systems are supported"

export CLOUD_INIT_USER="${CLOUD_INIT_USER:-"cloudinit"}"
export CLOUD_INIT_GROUP="${CLOUD_INIT_GROUP:-"${CLOUD_INIT_USER}"}"

if [[ "$(hostname)" == "localhost" ]]; then
    export CLOUD_INIT_HOSTNAME="${CLOUD_INIT_HOSTNAME:-"cloudinit"}"
else
    export CLOUD_INIT_HOSTNAME="${CLOUD_INIT_HOSTNAME:-"$(hostname)"}"
fi

export CLOUD_INIT_DOMAIN="${CLOUD_INIT_DOMAIN:-"easyiac.com"}"
export CLOUD_INIT_TIMEZONE="${CLOUD_INIT_TIMEZONE:-"Asia/Kolkata"}"
export CLOUD_INIT_COPY_ROOT_SSH_KEYS="${CLOUD_INIT_COPY_ROOT_SSH_KEYS:-"false"}"
export CLOUD_INIT_IS_DEV_MACHINE="${CLOUD_INIT_IS_DEV_MACHINE:-"false"}"
export CLOUD_INIT_INSTALL_DOTFILES="${CLOUD_INIT_INSTALL_DOTFILES:-"true"}"
export CLOUD_INIT_INSTALL_DOCKER="${CLOUD_INIT_INSTALL_DOCKER:-"false"}"

for __var in CLOUD_INIT_COPY_ROOT_SSH_KEYS CLOUD_INIT_IS_DEV_MACHINE CLOUD_INIT_INSTALL_DOTFILES \
    CLOUD_INIT_INSTALL_DOCKER; do
    [[ "${!__var}" =~ ^(true|false)$ ]] || die "${__var} must be true or false, got '${!__var}'"
done

for __var in CLOUD_INIT_USER CLOUD_INIT_GROUP; do
    [[ "${!__var}" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die "${__var} '${!__var}' is not a valid user/group name"
done

for __var in CLOUD_INIT_HOSTNAME CLOUD_INIT_DOMAIN; do
    [[ "${!__var}" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$ ]] ||
        die "${__var} '${!__var}' is not a valid host/domain name"
done

export NEBULA_TMP_DIR="${NEBULA_TMP_DIR:-"/cloudinit/.tmp"}"
export NEBULA_TMP_DIR="${NEBULA_TMP_DIR%/}"
export CLOUD_INIT_LOCK_FILE="${CLOUD_INIT_LOCK_FILE:-"${NEBULA_TMP_DIR}/setup-debian.lock"}"

export UV_VERSION="${UV_VERSION:-0.13.6}"
export UV_INSTALL_DIR="${UV_INSTALL_DIR:-"${NEBULA_TMP_DIR}/uv"}"
export UV_TARBALL="${UV_TARBALL:-"${NEBULA_TMP_DIR}/uv-$(uname -m)-${UV_VERSION}.tar.gz"}"
export UV_NO_MODIFY_PATH=1

export NEBULA_VERSION="${NEBULA_VERSION:-"1.23.0"}"
export NEBULA_PYTHON_VERSION="${NEBULA_PYTHON_VERSION:-"3.14.8"}"
export NEBULA_CLOUD_INIT_AUTHORIZED_KEYS_FILE="${NEBULA_CLOUD_INIT_AUTHORIZED_KEYS_FILE:-"${NEBULA_TMP_DIR}/authorized_keys"}"
export NEBULA_REQUIREMENTS_FILE="${NEBULA_REQUIREMENTS_FILE:-"${NEBULA_TMP_DIR}/requirements-${NEBULA_VERSION}.yml"}"

export DEFAULT_ROLES_PATH="${DEFAULT_ROLES_PATH:-"${NEBULA_TMP_DIR}/roles"}"
export ANSIBLE_ROLES_PATH="${ANSIBLE_ROLES_PATH:-"${DEFAULT_ROLES_PATH}"}"
export ANSIBLE_COLLECTIONS_PATH="${ANSIBLE_COLLECTIONS_PATH:-"${NEBULA_TMP_DIR}/collections"}"
export ANSIBLE_INVENTORY="${ANSIBLE_INVENTORY:-"${NEBULA_TMP_DIR}/inventory.yml"}"

# NEBULA_TMP_DIR is chowned recursively, first to root and then to the created user, so it must be a dedicated
# directory, and every other working path must live inside it.
[[ "${NEBULA_TMP_DIR}" =~ ^/[^/]+/.+ ]] ||
    die "NEBULA_TMP_DIR '${NEBULA_TMP_DIR}' must be an absolute path at least two levels deep"
for __var in CLOUD_INIT_LOCK_FILE UV_INSTALL_DIR UV_TARBALL NEBULA_CLOUD_INIT_AUTHORIZED_KEYS_FILE \
    NEBULA_REQUIREMENTS_FILE DEFAULT_ROLES_PATH ANSIBLE_ROLES_PATH ANSIBLE_COLLECTIONS_PATH ANSIBLE_INVENTORY; do
    [[ "${!__var}" == "${NEBULA_TMP_DIR}/"* ]] || die "${__var} '${!__var}' must be inside ${NEBULA_TMP_DIR}"
done

log "Configuration:
    CLOUD_INIT_USER: ${CLOUD_INIT_USER}
    CLOUD_INIT_GROUP: ${CLOUD_INIT_GROUP}
    CLOUD_INIT_HOSTNAME: ${CLOUD_INIT_HOSTNAME}
    CLOUD_INIT_DOMAIN: ${CLOUD_INIT_DOMAIN}
    CLOUD_INIT_TIMEZONE: ${CLOUD_INIT_TIMEZONE}
    CLOUD_INIT_COPY_ROOT_SSH_KEYS: ${CLOUD_INIT_COPY_ROOT_SSH_KEYS}
    CLOUD_INIT_IS_DEV_MACHINE: ${CLOUD_INIT_IS_DEV_MACHINE}
    CLOUD_INIT_INSTALL_DOTFILES: ${CLOUD_INIT_INSTALL_DOTFILES}
    CLOUD_INIT_INSTALL_DOCKER: ${CLOUD_INIT_INSTALL_DOCKER}
    NEBULA_TMP_DIR: ${NEBULA_TMP_DIR}
    NEBULA_VERSION: ${NEBULA_VERSION}
    NEBULA_PYTHON_VERSION: ${NEBULA_PYTHON_VERSION}
    UV_VERSION: ${UV_VERSION}
    ANSIBLE_INVENTORY: ${ANSIBLE_INVENTORY}"

mkdir -p "${NEBULA_TMP_DIR}" "$(dirname "${CLOUD_INIT_LOCK_FILE}")"

# The lock is held on an open file descriptor, so the kernel releases it when the script exits for any reason.
exec {__lock_fd}>"${CLOUD_INIT_LOCK_FILE}"
if ! flock -n "${__lock_fd}"; then
    die "Another setup-debian run holds the lock ${CLOUD_INIT_LOCK_FILE}"
fi

__apt_get=(apt-get -o DPkg::Lock::Timeout=600 -o Acquire::Retries=3)

log "Installing base packages"
"${__apt_get[@]}" update
"${__apt_get[@]}" install -y locales tzdata git curl ca-certificates gnupg2 tar unzip \
    sudo bash python3-pip vim python3-requests python3-httpx jq

__work_dir="$(mktemp -d "${NEBULA_TMP_DIR}/setup-debian.XXXXXX")"
trap 'rm -rf "${__work_dir}"' EXIT

__curl() {
    curl -fsSL --retry 3 --retry-delay 2 --connect-timeout 10 "$@"
}

__verify_sha256() {
    echo "${1}  ${2}" | sha256sum -c --status -
}

# Quotes a value as a JSON string, which is also a valid YAML scalar.
__yaml_str() {
    jq -cn --arg v "$1" '$v'
}

log "Changing ownership of ${NEBULA_TMP_DIR} to root:root"
chown -R root:root "${NEBULA_TMP_DIR}"

# Always reinstalled from the verified tarball: the previous run handed the binaries to the created user, and root
# must not execute anything that user could have replaced.
__install_uv() {
    local asset_name expected_hash
    asset_name="uv-$(uname -m)-unknown-linux-gnu.tar.gz"
    expected_hash="$(__curl --max-time 60 "https://api.github.com/repos/astral-sh/uv/releases/tags/${UV_VERSION}" |
        jq -r --arg name "${asset_name}" '.assets[] | select(.name == $name) | .digest' |
        sed 's/^sha256://')"
    if [[ -z "${expected_hash}" || "${expected_hash}" == "null" ]]; then
        die "Failed to get the checksum of ${asset_name} from the uv ${UV_VERSION} GitHub release"
    fi

    mkdir -p "$(dirname "${UV_TARBALL}")" "${UV_INSTALL_DIR}"

    if [[ -f "${UV_TARBALL}" ]] && ! __verify_sha256 "${expected_hash}" "${UV_TARBALL}"; then
        log "Cached ${UV_TARBALL} failed checksum verification, downloading it again"
        rm -f "${UV_TARBALL}"
    fi

    if [[ ! -f "${UV_TARBALL}" ]]; then
        log "Downloading uv ${UV_VERSION} to ${UV_TARBALL}"
        __curl --max-time 600 -o "${__work_dir}/${asset_name}" \
            "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/${asset_name}"
        __verify_sha256 "${expected_hash}" "${__work_dir}/${asset_name}" ||
            die "Checksum mismatch for the downloaded ${asset_name}"
        mv -f "${__work_dir}/${asset_name}" "${UV_TARBALL}"
    fi

    log "Extracting uv ${UV_VERSION} to ${UV_INSTALL_DIR}"
    mkdir -p "${__work_dir}/uv"
    tar -xzf "${UV_TARBALL}" -C "${__work_dir}/uv" --strip-components=1
    install -m 755 "${__work_dir}/uv/uv" "${__work_dir}/uv/uvx" "${UV_INSTALL_DIR}/"
}

__install_uv

if [[ -z "${CLOUD_INIT_USE_SSH_PUB:-}" ]]; then
    log "Downloading the default SSH public key"
    CLOUD_INIT_USE_SSH_PUB="$(__curl --max-time 60 \
        https://raw.githubusercontent.com/arpanrec/dotfiles/refs/heads/assets/id_ecdsa.pub)" ||
        die "Failed to download the default SSH public key, set CLOUD_INIT_USE_SSH_PUB"
fi
export CLOUD_INIT_USE_SSH_PUB
[[ -n "${CLOUD_INIT_USE_SSH_PUB//[[:space:]]/}" ]] || die "CLOUD_INIT_USE_SSH_PUB is empty"

while IFS= read -r __key; do
    [[ -z "${__key//[[:space:]]/}" ]] && continue
    [[ "${__key}" =~ ^(ssh-(rsa|ed25519|dss)|ecdsa-sha2-nistp(256|384|521)|sk-(ssh-ed25519|ecdsa-sha2-nistp256)@openssh\.com)\ [A-Za-z0-9+/]+=*(\ .*)?$ ]] ||
        die "CLOUD_INIT_USE_SSH_PUB has a line that is not an SSH public key: ${__key}"
done <<<"${CLOUD_INIT_USE_SSH_PUB}"
log "CLOUD_INIT_USE_SSH_PUB: ${CLOUD_INIT_USE_SSH_PUB}"

log "Setting timezone to ${CLOUD_INIT_TIMEZONE}"
[[ -f "/usr/share/zoneinfo/${CLOUD_INIT_TIMEZONE}" ]] || die "Unknown timezone ${CLOUD_INIT_TIMEZONE}"
if ! timedatectl set-timezone "${CLOUD_INIT_TIMEZONE}" 2>/dev/null; then
    log "timedatectl is unavailable, linking /etc/localtime directly"
    ln -sfn "/usr/share/zoneinfo/${CLOUD_INIT_TIMEZONE}" /etc/localtime
    echo "${CLOUD_INIT_TIMEZONE}" >/etc/timezone
fi

log "Generating locale en_US.UTF-8"
sed -i '/^en_US.UTF-8 UTF-8$/d' /etc/locale.gen
echo "en_US.UTF-8 UTF-8" >>/etc/locale.gen
locale-gen
printf 'LANG=en_US.UTF-8\nLC_ALL=en_US.UTF-8\n' >/etc/default/locale
localectl set-locale LANG=en_US.UTF-8 2>/dev/null || true

log "Setting vim as the default editor"
touch /etc/environment
sed -i '/^EDITOR=.*/d' /etc/environment
echo "EDITOR=vim" >>/etc/environment

mkdir -p "$(dirname "${NEBULA_CLOUD_INIT_AUTHORIZED_KEYS_FILE}")" "$(dirname "${NEBULA_REQUIREMENTS_FILE}")" \
    "${DEFAULT_ROLES_PATH}" "${ANSIBLE_ROLES_PATH}" "${ANSIBLE_COLLECTIONS_PATH}" "$(dirname "${ANSIBLE_INVENTORY}")"

log "Writing ${NEBULA_CLOUD_INIT_AUTHORIZED_KEYS_FILE}"
printf '%s\n' "${CLOUD_INIT_USE_SSH_PUB}" >"${NEBULA_CLOUD_INIT_AUTHORIZED_KEYS_FILE}"
if [[ "${CLOUD_INIT_COPY_ROOT_SSH_KEYS}" == true && -f /root/.ssh/authorized_keys ]]; then
    log "Adding root's authorized_keys to ${NEBULA_CLOUD_INIT_AUTHORIZED_KEYS_FILE}"
    cat /root/.ssh/authorized_keys >>"${NEBULA_CLOUD_INIT_AUTHORIZED_KEYS_FILE}"
fi

if [[ ! -f "${NEBULA_REQUIREMENTS_FILE}" ]]; then
    log "Downloading ${NEBULA_REQUIREMENTS_FILE}"
    __curl --max-time 60 -o "${__work_dir}/requirements.yml" \
        "https://raw.githubusercontent.com/arpanrec/ansible-collection-nebula/refs/tags/${NEBULA_VERSION}/requirements.yml"
    mv -f "${__work_dir}/requirements.yml" "${NEBULA_REQUIREMENTS_FILE}"
fi

__uvx_ansible=("${UV_INSTALL_DIR}/uvx" --python "${NEBULA_PYTHON_VERSION}" --from ansible-core --with ansible
    --with hvac --with httpx --with requests)

log "Installing Ansible requirements for nebula ${NEBULA_VERSION}"
"${__uvx_ansible[@]}" ansible-galaxy install -r "${NEBULA_REQUIREMENTS_FILE}"
"${__uvx_ansible[@]}" ansible-galaxy collection install \
    "git+https://github.com/arpanrec/ansible-collection-nebula.git,${NEBULA_VERSION}"

log "Writing Ansible inventory ${ANSIBLE_INVENTORY}"
cat >"${ANSIBLE_INVENTORY}" <<EOF
---
all:
    children:
        cloudinit:
            hosts:
                localhost:
            vars:
                ansible_user: root
                ansible_become: false
                pv_cloud_init_user: $(__yaml_str "${CLOUD_INIT_USER}")
                pv_cloud_init_group: $(__yaml_str "${CLOUD_INIT_GROUP}")
                pv_cloud_init_authorized_keys: $(__yaml_str "${NEBULA_CLOUD_INIT_AUTHORIZED_KEYS_FILE}")
                pv_cloud_init_is_dev_machine: ${CLOUD_INIT_IS_DEV_MACHINE}
                pv_cloud_init_hostname: $(__yaml_str "${CLOUD_INIT_HOSTNAME}")
                pv_cloud_init_domain: $(__yaml_str "${CLOUD_INIT_DOMAIN}")
                pv_cloud_init_install_docker: ${CLOUD_INIT_INSTALL_DOCKER}
    hosts:
        localhost:
            ansible_connection: local
            ansible_python_interpreter: "/usr/bin/python3"
EOF

log "Running arpanrec.nebula.cloudinit"
"${__uvx_ansible[@]}" ansible-playbook arpanrec.nebula.cloudinit

id "${CLOUD_INIT_USER}" >/dev/null 2>&1 || die "User ${CLOUD_INIT_USER} does not exist after the cloudinit playbook"

log "Changing ownership of ${NEBULA_TMP_DIR} to ${CLOUD_INIT_USER}:${CLOUD_INIT_GROUP}"
chown -R "${CLOUD_INIT_USER}:${CLOUD_INIT_GROUP}" "${NEBULA_TMP_DIR}"

ANSIBLE_INVENTORY="$(dirname "${ANSIBLE_INVENTORY}")/setup-workspace-inventory.yml"
export ANSIBLE_INVENTORY

# Runs a script from the main branch of the dotfiles repository as the created user. The script is downloaded first,
# so a failed download stops this run instead of running an empty script.
__run_as_user() {
    local name="$1"
    shift
    log "Running ${name} as ${CLOUD_INIT_USER}"
    __curl --max-time 60 -o "${__work_dir}/${name}" \
        "https://raw.githubusercontent.com/arpanrec/dotfiles/refs/heads/main/${name}"
    chmod 644 "${__work_dir}/${name}"
    (cd / && sudo -E -H -u "${CLOUD_INIT_USER}" \
        env HOME="/home/${CLOUD_INIT_USER}" USER="${CLOUD_INIT_USER}" LOGNAME="${CLOUD_INIT_USER}" \
        bash "${__work_dir}/${name}" "$@")
}

if [[ "${CLOUD_INIT_INSTALL_DOTFILES}" == true ]]; then
    __run_as_user install-dotfiles
fi

if [[ "${CLOUD_INIT_IS_DEV_MACHINE}" == true ]]; then
    __run_as_user setup-workspace --tags all
fi

log "Setting up the login banner"
rm -f /etc/update-motd.d/10-uname

if "${__apt_get[@]}" install -y fastfetch; then
    cat >/etc/update-motd.d/10-osinfo-setup-debian <<'EOF'
#!/bin/bash
fastfetch || true
EOF
    chown root:root /etc/update-motd.d/10-osinfo-setup-debian
    chmod 755 /etc/update-motd.d/10-osinfo-setup-debian
else
    log "fastfetch is not available in this release's repositories, skipping the system info banner"
fi

cat >/etc/motd <<'EOF'
############################################################
#       First of all, if you are not me,                   #
#       Get the fuck out of here                           #
#       or                                                 #
#       fuck around and find out.                          #
############################################################
#       STOP! You've reached the peak                      #
#       of your questionable life choices                  #
############################################################
#       Hey, fancy seeing *you* here.                      #
#       Remember, every command you type                   #
#       reminds the server it deserves a better user.      #
#                                                          #
#       Please don't mess things up (again).               #
#       And if you do, IT knows.                           #
############################################################
#       Type 'exit' to repent.                             #
############################################################
EOF

log "Completed"
