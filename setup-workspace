#!/usr/bin/env bash
# Provisions a developer toolchain with the arpanrec.nebula.server_workspace Ansible playbook.
#
# Without arguments, prompts for the tool tags to install.
# With arguments, passes them straight to ansible-playbook, e.g. `setup-workspace --tags all`.
set -euo pipefail

log() {
    printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >&2
}

die() {
    log "ERROR: $*"
    exit 1
}

if [[ "$(id -u)" -eq 0 || "${HOME}" == "/root" ]]; then
    die "Root user detected, run this script as a non-root user"
fi

if [[ "$(uname -s)" != "Linux" ]]; then
    die "Unsupported OS $(uname -s), only Linux is supported"
fi

for __cmd in curl jq tar sha256sum flock mktemp; do
    command -v "${__cmd}" >/dev/null 2>&1 || die "${__cmd} is not installed"
done

export NEBULA_TMP_DIR="${NEBULA_TMP_DIR:-"${HOME}/.cache/ansible-nebula-cache"}"
export NEBULA_TMP_DIR="${NEBULA_TMP_DIR%/}"
export SERVER_WORKSPACE_LOCK_FILE="${SERVER_WORKSPACE_LOCK_FILE:-"${NEBULA_TMP_DIR}/setup-workspace.lock"}"

export UV_VERSION="${UV_VERSION:-0.13.6}"
export UV_INSTALL_DIR="${UV_INSTALL_DIR:-"${NEBULA_TMP_DIR}/uv"}"
export UV_TARBALL="${UV_TARBALL:-"${NEBULA_TMP_DIR}/uv-$(uname -m)-${UV_VERSION}.tar.gz"}"

export NEBULA_VERSION="${NEBULA_VERSION:-"1.23.0"}"
export NEBULA_PYTHON_VERSION="${NEBULA_PYTHON_VERSION:-"3.14.8"}"
export NEBULA_EXTRA_VARS_JSON_FILE="${NEBULA_EXTRA_VARS_JSON_FILE:-"${NEBULA_TMP_DIR}/extra_vars.json"}"
export NEBULA_REQUIREMENTS_FILE="${NEBULA_REQUIREMENTS_FILE:-"${NEBULA_TMP_DIR}/requirements-${NEBULA_VERSION}.yml"}"

export DEFAULT_ROLES_PATH="${DEFAULT_ROLES_PATH:-"${NEBULA_TMP_DIR}/roles"}"
export ANSIBLE_ROLES_PATH="${ANSIBLE_ROLES_PATH:-"${DEFAULT_ROLES_PATH}"}"
export ANSIBLE_COLLECTIONS_PATH="${ANSIBLE_COLLECTIONS_PATH:-"${NEBULA_TMP_DIR}/collections"}"
export ANSIBLE_INVENTORY="${ANSIBLE_INVENTORY:-"${NEBULA_TMP_DIR}/inventory.yml"}"

# Tags of the server_workspace playbook offered in the interactive prompt, in playbook order, as "tag:label".
__tag_choices=(
    "nodejs:Node.js"
    "go:Go"
    "java:Oracle JDK"
    "terraform:Terraform"
    "vault:Vault"
    "pulumi:Pulumi"
    "bws:Bitwarden SDK"
    "hadolint:Hadolint"
    "gitleaks:Gitleaks"
    "uv:uv"
    "rclone:Rclone"
    "bun:Bun"
)

mkdir -p "${NEBULA_TMP_DIR}" "$(dirname "${SERVER_WORKSPACE_LOCK_FILE}")"

# The lock is held on an open file descriptor, so the kernel releases it when the script exits for any reason.
exec {__lock_fd}>"${SERVER_WORKSPACE_LOCK_FILE}"
if ! flock -n "${__lock_fd}"; then
    die "Another setup-workspace run holds the lock ${SERVER_WORKSPACE_LOCK_FILE}"
fi

__work_dir="$(mktemp -d "${NEBULA_TMP_DIR}/setup-workspace.XXXXXX")"
trap 'rm -rf "${__work_dir}"' EXIT

__curl() {
    curl -fsSL --retry 3 --retry-delay 2 --connect-timeout 10 "$@"
}

__verify_sha256() {
    echo "${1}  ${2}" | sha256sum -c --status -
}

__install_uv() {
    local installed_version=""
    if [[ -x "${UV_INSTALL_DIR}/uv" && -x "${UV_INSTALL_DIR}/uvx" ]]; then
        read -r _ installed_version _ < <("${UV_INSTALL_DIR}/uv" --version 2>/dev/null) || true
    fi
    if [[ "${installed_version}" == "${UV_VERSION}" ]]; then
        log "uv ${UV_VERSION} is already installed in ${UV_INSTALL_DIR}"
        return
    fi

    local asset_name expected_hash
    asset_name="uv-$(uname -m)-unknown-linux-gnu.tar.gz"
    expected_hash="$(__curl --max-time 60 "https://api.github.com/repos/astral-sh/uv/releases/tags/${UV_VERSION}" |
        jq -r --arg name "${asset_name}" '.assets[] | select(.name == $name) | .digest' |
        sed 's/^sha256://')"
    if [[ -z "${expected_hash}" || "${expected_hash}" == "null" ]]; then
        die "Failed to get the checksum of ${asset_name} from the uv ${UV_VERSION} GitHub release"
    fi

    mkdir -p "$(dirname "${UV_TARBALL}")" "${UV_INSTALL_DIR}"

    if [[ -f "${UV_TARBALL}" ]] && ! __verify_sha256 "${expected_hash}" "${UV_TARBALL}"; then
        log "Cached ${UV_TARBALL} failed checksum verification, downloading it again"
        rm -f "${UV_TARBALL}"
    fi

    if [[ ! -f "${UV_TARBALL}" ]]; then
        log "Downloading uv ${UV_VERSION} to ${UV_TARBALL}"
        __curl --max-time 600 -o "${__work_dir}/${asset_name}" \
            "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/${asset_name}"
        __verify_sha256 "${expected_hash}" "${__work_dir}/${asset_name}" ||
            die "Checksum mismatch for the downloaded ${asset_name}"
        mv -f "${__work_dir}/${asset_name}" "${UV_TARBALL}"
    fi

    log "Extracting uv ${UV_VERSION} to ${UV_INSTALL_DIR}"
    mkdir -p "${__work_dir}/uv"
    tar -xzf "${UV_TARBALL}" -C "${__work_dir}/uv" --strip-components=1
    install -m 755 "${__work_dir}/uv/uv" "${__work_dir}/uv/uvx" "${UV_INSTALL_DIR}/"
}

__select_tags() {
    local choice tag label answer
    local -a selected=()

    for choice in "${__tag_choices[@]}"; do
        tag="${choice%%:*}"
        label="${choice#*:}"
        read -n1 -r -p "Install ${label}? [y/N] " answer </dev/tty || answer=""
        echo >&2
        if [[ "${answer}" == [yY] ]]; then
            selected+=("${tag}")
        fi
    done

    if [[ ${#selected[@]} -eq 0 ]]; then
        log "No tags selected, nothing to install"
        exit 0
    fi

    local IFS=,
    __ansible_tags="${selected[*]}"
}

__ansible_args=()
if [[ $# -eq 0 ]]; then
    [[ -t 0 && -r /dev/tty ]] || die "No arguments given and no terminal for prompts, pass e.g. --tags all"
    __select_tags
    read -n1 -r -p "Run the playbook with tags ${__ansible_tags}? [y/N] " __confirm </dev/tty || __confirm=""
    echo >&2
    [[ "${__confirm}" == [yY] ]] || die "Aborted by user"
    __ansible_args=(--tags "${__ansible_tags}")
else
    __ansible_args=("$@")
fi

log "Configuration:
    NEBULA_TMP_DIR: ${NEBULA_TMP_DIR}
    NEBULA_VERSION: ${NEBULA_VERSION}
    NEBULA_PYTHON_VERSION: ${NEBULA_PYTHON_VERSION}
    NEBULA_EXTRA_VARS_JSON_FILE: ${NEBULA_EXTRA_VARS_JSON_FILE}
    NEBULA_REQUIREMENTS_FILE: ${NEBULA_REQUIREMENTS_FILE}
    UV_VERSION: ${UV_VERSION}
    UV_INSTALL_DIR: ${UV_INSTALL_DIR}
    ANSIBLE_ROLES_PATH: ${ANSIBLE_ROLES_PATH}
    ANSIBLE_COLLECTIONS_PATH: ${ANSIBLE_COLLECTIONS_PATH}
    ANSIBLE_INVENTORY: ${ANSIBLE_INVENTORY}
    ansible-playbook arguments: ${__ansible_args[*]}"

__install_uv

mkdir -p "${DEFAULT_ROLES_PATH}" "${ANSIBLE_ROLES_PATH}" "${ANSIBLE_COLLECTIONS_PATH}" \
    "$(dirname "${ANSIBLE_INVENTORY}")" "$(dirname "${NEBULA_EXTRA_VARS_JSON_FILE}")" \
    "$(dirname "${NEBULA_REQUIREMENTS_FILE}")"

if [[ ! -f "${NEBULA_REQUIREMENTS_FILE}" ]]; then
    log "Downloading ${NEBULA_REQUIREMENTS_FILE}"
    __curl --max-time 60 -o "${__work_dir}/requirements.yml" \
        "https://raw.githubusercontent.com/arpanrec/ansible-collection-nebula/refs/tags/${NEBULA_VERSION}/requirements.yml"
    mv -f "${__work_dir}/requirements.yml" "${NEBULA_REQUIREMENTS_FILE}"
fi

if [[ ! -f "${NEBULA_EXTRA_VARS_JSON_FILE}" ]]; then
    log "Creating empty ${NEBULA_EXTRA_VARS_JSON_FILE}"
    echo "{}" >"${NEBULA_EXTRA_VARS_JSON_FILE}"
fi
jq -e 'type == "object"' "${NEBULA_EXTRA_VARS_JSON_FILE}" >/dev/null ||
    die "${NEBULA_EXTRA_VARS_JSON_FILE} is not a JSON object"

log "Writing Ansible inventory ${ANSIBLE_INVENTORY}"
cat >"${ANSIBLE_INVENTORY}" <<'EOF'
---
all:
    children:
        server_workspace:
            hosts:
                localhost:
            vars:
                ansible_become: false
    hosts:
        localhost:
            ansible_connection: local
            ansible_python_interpreter: "{{ ansible_playbook_python }}"
EOF

__uvx_ansible=("${UV_INSTALL_DIR}/uvx" --python "${NEBULA_PYTHON_VERSION}" --from ansible-core --with ansible
    --with hvac --with httpx --with requests)

log "Installing Ansible requirements for nebula ${NEBULA_VERSION}"
"${__uvx_ansible[@]}" ansible-galaxy install -r "${NEBULA_REQUIREMENTS_FILE}"
"${__uvx_ansible[@]}" ansible-galaxy collection install \
    "git+https://github.com/arpanrec/ansible-collection-nebula.git,${NEBULA_VERSION}"

cd "${HOME}"

log "Running arpanrec.nebula.server_workspace"
"${__uvx_ansible[@]}" ansible-playbook arpanrec.nebula.server_workspace \
    --extra-vars "@${NEBULA_EXTRA_VARS_JSON_FILE}" "${__ansible_args[@]}"

log "Completed"
